# Accès SSH à la préprod Hostinger.
# Copier ce fichier en ops/.env.preprod (ignoré par Git) et le remplir.
# Aucun mot de passe ici : la connexion se fait par clé SSH.

# hPanel > Avancé > Accès SSH
SSH_HOST=
SSH_PORT=65002
SSH_USER=

# Chemin absolu du dossier WordPress sur le serveur (celui qui contient wp-config.php).
# Exemple : /home/u123456789/domains/preprod.bigm-burger.fr/public_html
WP_PATH=

# Identifiant d'un administrateur WordPress (pour appliquer la charte au kit Elementor).
WP_ADMIN=
